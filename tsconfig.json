{
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmitOnError": true,
    "outDir": "lib",
    "rootDir": "labextension/src",
    "strict": true,
    "target": "ES2022"
  },
  "include": [
    "labextension/src/**/*.ts"
  ]
}
