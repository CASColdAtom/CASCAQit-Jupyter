{
  "name": "CASCAQit Jupyter",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/start-jupyter.sh",
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": {
      "label": "CASCAQit JupyterLab",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "CASColdAtom/CASCAQit": {
          "permissions": {
            "contents": "read"
          }
        }
      }
    },
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ]
    }
  },
  "remoteUser": "vscode"
}
