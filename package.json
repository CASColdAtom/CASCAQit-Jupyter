{
  "name": "@cascaqit/jupyter",
  "version": "0.1.0-alpha.2",
  "description": "CASCAQit visual editors and safe MIME renderers for JupyterLab 4 and Notebook 7",
  "license": "Apache-2.0",
  "private": true,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "labextension/style/**/*"
  ],
  "scripts": {
    "build:labextension": "jupyter labextension build .",
    "build:lib": "tsc --build --force",
    "build:prod": "npm run clean && npm run build:lib && npm run build:labextension",
    "clean": "rimraf lib src/cascaqit_jupyter/labextension",
    "test:e2e": "sh tests/e2e/run.sh",
    "test:frontend": "vitest run labextension/test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@bokeh/bokehjs": "^3.9.2",
    "@jupyterlab/application": "^4.0.2",
    "@jupyterlab/apputils": "^4.1.2",
    "@jupyterlab/cells": "^4.5.10",
    "@jupyterlab/notebook": "^4.0.2",
    "@jupyterlab/rendermime-interfaces": "^3.8.2",
    "@lumino/widgets": "^2.9.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.5.10",
    "@playwright/test": "^1.62.0",
    "jsdom": "^26.1.0",
    "rimraf": "^6.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "overrides": {
    "sanitize-html": "2.17.6",
    "@jupyterlab/builder": {
      "glob": "^13.0.6"
    }
  },
  "jupyterlab": {
    "extension": "lib/plugin.js",
    "mimeExtension": true,
    "outputDir": "src/cascaqit_jupyter/labextension",
    "sharedPackages": {
      "@jupyterlab/application": {
        "requiredVersion": "^4.0.2"
      },
      "@jupyterlab/apputils": {
        "requiredVersion": "^4.1.2"
      },
      "@jupyterlab/notebook": {
        "requiredVersion": "^4.0.2"
      },
      "@jupyterlab/rendermime-interfaces": {
        "requiredVersion": "^3.8.2"
      }
    }
  }
}
